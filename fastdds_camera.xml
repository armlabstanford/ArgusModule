<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Camera node only. The default shared-memory segment is 512 KB, about two
  640x400 frames, so while a slow reader such as OpenVINS holds frames the
  camera has no buffer for the next one and best-effort frames are dropped.
  16 MB holds about 60 frames. Discovery and UDP are left at their defaults.
  Used through FASTRTPS_DEFAULT_PROFILES_FILE by bringup_sensors.sh.
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <transport_descriptors>
        <transport_descriptor>
            <transport_id>argus_camera_shm</transport_id>
            <type>SHM</type>
            <segment_size>16777216</segment_size>
        </transport_descriptor>
        <transport_descriptor>
            <transport_id>argus_camera_udp</transport_id>
            <type>UDPv4</type>
        </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="argus_camera" is_default_profile="true">
        <rtps>
            <userTransports>
                <transport_id>argus_camera_shm</transport_id>
                <transport_id>argus_camera_udp</transport_id>
            </userTransports>
            <useBuiltinTransports>false</useBuiltinTransports>
        </rtps>
    </participant>
</profiles>
