<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Discovery over the hotspot: Wi-Fi multicast is unreliable, so each Pi also
  announces itself by unicast to the hotspot host (10.42.0.1) and to local
  processes. maxInitialPeersRange covers up to 32 ROS processes per address.
  Used through FASTRTPS_DEFAULT_PROFILES_FILE by the bringup scripts.
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <transport_descriptors>
        <transport_descriptor>
            <transport_id>argus_udp</transport_id>
            <type>UDPv4</type>
            <maxInitialPeersRange>32</maxInitialPeersRange>
        </transport_descriptor>
        <transport_descriptor>
            <transport_id>argus_shm</transport_id>
            <type>SHM</type>
        </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="argus_unicast_discovery" is_default_profile="true">
        <rtps>
            <userTransports>
                <transport_id>argus_shm</transport_id>
                <transport_id>argus_udp</transport_id>
            </userTransports>
            <useBuiltinTransports>false</useBuiltinTransports>
            <builtin>
                <initialPeersList>
                    <locator>
                        <udpv4>
                            <address>127.0.0.1</address>
                        </udpv4>
                    </locator>
                    <locator>
                        <udpv4>
                            <address>10.42.0.1</address>
                        </udpv4>
                    </locator>
                </initialPeersList>
            </builtin>
        </rtps>
    </participant>
</profiles>
